# ===================================
# GLOBAL BUSINESS AUTOMATION SUITE
# Configuração de Ambiente
# ===================================

# ===================================
# APLICAÇÃO
# ===================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Global Business Automation Suite"

# ===================================
# BANCO DE DADOS
# ===================================
# Desenvolvimento (SQLite local)
DATABASE_URL=file:./dev.db

# Produção (Cloudflare D1)
# DATABASE_URL=cloudflare://your-d1-database

# ===================================
# AUTENTICAÇÃO
# ===================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here-generate-with-openssl

# JWT
JWT_SECRET=your-jwt-secret-here

# ===================================
# PAGAMENTOS
# ===================================

# Asaas (Principal - Brasil)
ASAAS_API_KEY=your-asaas-api-key
ASAAS_WALLET_ID=your-asaas-wallet-id
ASAAS_WEBHOOK_SECRET=your-webhook-secret

# PayPal (Internacional)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox # sandbox ou production

# Square (Alternativa)
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_LOCATION_ID=your-square-location-id
SQUARE_ENVIRONMENT=sandbox # sandbox ou production

# ===================================
# CONECTORES CLAUDE
# ===================================

# Gmail
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
GMAIL_FROM_EMAIL=automation@yourdomain.com

# Google Drive
GOOGLE_DRIVE_CLIENT_ID=your-drive-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-drive-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=your-drive-refresh-token
GOOGLE_DRIVE_FOLDER_ID=your-main-folder-id

# Google Calendar
GOOGLE_CALENDAR_CLIENT_ID=your-calendar-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-calendar-client-secret
GOOGLE_CALENDAR_REFRESH_TOKEN=your-calendar-refresh-token

# Intercom
INTERCOM_ACCESS_TOKEN=your-intercom-access-token
INTERCOM_APP_ID=your-intercom-app-id

# GitHub
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_ORG=your-github-organization
GITHUB_DEPLOY_WEBHOOK=your-deploy-webhook-url

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Figma
FIGMA_ACCESS_TOKEN=your-figma-access-token
FIGMA_TEAM_ID=your-figma-team-id

# Vercel
VERCEL_TOKEN=your-vercel-token
VERCEL_TEAM_ID=your-vercel-team-id

# ===================================
# INTELIGÊNCIA ARTIFICIAL
# ===================================

# Hugging Face
HUGGINGFACE_API_KEY=your-huggingface-api-key

# Claude (Anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key

# ===================================
# SERVIÇOS DE TERCEIROS
# ===================================

# WhatsApp Business
WHATSAPP_API_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Twilio (SMS/WhatsApp backup)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# SendGrid (Email backup)
SENDGRID_API_KEY=your-sendgrid-api-key

# ===================================
# REDIS (Cache e Filas)
# ===================================
REDIS_URL=redis://localhost:6379
# Produção (Upstash)
# REDIS_URL=your-upstash-redis-url

# ===================================
# MONITORAMENTO
# ===================================

# Sentry
SENTRY_DSN=your-sentry-dsn

# Google Analytics
NEXT_PUBLIC_GA_ID=your-google-analytics-id

# ===================================
# WEBHOOKS
# ===================================
WEBHOOK_SECRET=your-webhook-secret-key

# ===================================
# SEGURANÇA
# ===================================
ENCRYPTION_KEY=your-encryption-key-32-characters

# ===================================
# RECURSOS EXTERNOS
# ===================================

# Proxies
PROXY_BRASIL_API=your-proxy-brasil-api
PROXY_USA_API=your-proxy-usa-api
PROXY_LATAM_API=your-proxy-latam-api
PROXY_EU_API=your-proxy-eu-api

# TikTok Shop API
TIKTOK_API_KEY=your-tiktok-api-key
TIKTOK_API_SECRET=your-tiktok-api-secret

# Facebook/Meta
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# Google Ads
GOOGLE_ADS_CLIENT_ID=your-google-ads-client-id
GOOGLE_ADS_CLIENT_SECRET=your-google-ads-client-secret
