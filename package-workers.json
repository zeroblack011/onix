{
  "name": "global-business-automation-suite",
  "version": "1.0.0",
  "description": "Sistema Definitivo de Automação Empresarial - Cloudflare Workers Edition",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:workers": "npx @cloudflare/next-on-pages",
    "preview": "npx wrangler pages dev .vercel/output/static",
    "deploy": "npm run build:workers && wrangler pages deploy .vercel/output/static",
    "start": "next start",
    "lint": "next lint",
    "db:create": "wrangler d1 create business_automation_db",
    "db:migrate": "wrangler d1 execute business_automation_db --file=./schema.sql",
    "db:query": "wrangler d1 execute business_automation_db --command",
    "db:backup": "wrangler d1 export business_automation_db --output=backup.sql",
    "kv:create": "wrangler kv:namespace create CACHE_KV",
    "kv:create:preview": "wrangler kv:namespace create CACHE_KV --preview",
    "r2:create": "wrangler r2 bucket create business-automation-uploads",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",

    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",

    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-avatar": "^1.0.4",

    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.3.0",
    "lucide-react": "^0.376.0",

    "drizzle-orm": "^0.30.10",
    "@libsql/client": "^0.6.0",

    "zod": "^3.23.0",
    "react-hook-form": "^7.51.0",
    "@hookform/resolvers": "^3.3.4",

    "jose": "^5.2.0",

    "axios": "^1.6.8",
    "date-fns": "^3.6.0",
    "recharts": "^2.12.0",
    "react-dropzone": "^14.2.3",

    "@huggingface/inference": "^2.6.4",
    "uuid": "^9.0.1",
    "@types/uuid": "^9.0.8"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.11.0",
    "@cloudflare/workers-types": "^4.20240208.0",
    "wrangler": "^3.28.0",

    "drizzle-kit": "^0.21.0",

    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "prettier": "^3.2.0",
    "prettier-plugin-tailwindcss": "^0.5.0",

    "jest": "^29.7.0",
    "@testing-library/react": "^14.2.0",
    "@testing-library/jest-dom": "^6.4.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
